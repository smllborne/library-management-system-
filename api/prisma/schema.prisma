generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique 
  password  String 
  role      Role  @default(PATRON)

}

model Genre {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  slug    String   @unique
  books   Book[]
}

model Book {
  id         Int     @id @default(autoincrement())
  title      String
  author     String
  isbn       String  @unique
  description  String
  coverImage   String?
  totalCopies  Int  @default(1)
  availableCopies  Int   @default(1)
  genreld  Int
  genre    Genre  @relation(fields: [genreld], references: [id])
  createdAt  DateTime  @default(now())
}